# RUN: llc %s -mtriple=mips64el-scei-ps2 -mcpu=r5900 -mattr=+vu0 \
# RUN:   -start-after=finalize-isel -o - | FileCheck %s

# VF0 is reserved, so 32 simultaneously live v4f32 values force a spill.
# The spill path must use native 16-byte VU0 transfers rather than MSA ops.
--- |
  define void @vu0_pressure(ptr %input, ptr %output) {
    ret void
  }

  define void @vu0_copy() {
    ret void
  }
...
---
name:            vu0_pressure
alignment:       8
tracksRegLiveness: true
liveins:
  - { reg: '$a0' }
  - { reg: '$a1' }
body:             |
  bb.0:
    liveins: $a0, $a1

    %0:vfregs = LQC2 $a0, 0
    %1:vfregs = LQC2 $a0, 16
    %2:vfregs = LQC2 $a0, 32
    %3:vfregs = LQC2 $a0, 48
    %4:vfregs = LQC2 $a0, 64
    %5:vfregs = LQC2 $a0, 80
    %6:vfregs = LQC2 $a0, 96
    %7:vfregs = LQC2 $a0, 112
    %8:vfregs = LQC2 $a0, 128
    %9:vfregs = LQC2 $a0, 144
    %10:vfregs = LQC2 $a0, 160
    %11:vfregs = LQC2 $a0, 176
    %12:vfregs = LQC2 $a0, 192
    %13:vfregs = LQC2 $a0, 208
    %14:vfregs = LQC2 $a0, 224
    %15:vfregs = LQC2 $a0, 240
    %16:vfregs = LQC2 $a0, 256
    %17:vfregs = LQC2 $a0, 272
    %18:vfregs = LQC2 $a0, 288
    %19:vfregs = LQC2 $a0, 304
    %20:vfregs = LQC2 $a0, 320
    %21:vfregs = LQC2 $a0, 336
    %22:vfregs = LQC2 $a0, 352
    %23:vfregs = LQC2 $a0, 368
    %24:vfregs = LQC2 $a0, 384
    %25:vfregs = LQC2 $a0, 400
    %26:vfregs = LQC2 $a0, 416
    %27:vfregs = LQC2 $a0, 432
    %28:vfregs = LQC2 $a0, 448
    %29:vfregs = LQC2 $a0, 464
    %30:vfregs = LQC2 $a0, 480
    %31:vfregs = LQC2 $a0, 496
    SQC2 killed %0, $a1, 0
    SQC2 killed %1, $a1, 16
    SQC2 killed %2, $a1, 32
    SQC2 killed %3, $a1, 48
    SQC2 killed %4, $a1, 64
    SQC2 killed %5, $a1, 80
    SQC2 killed %6, $a1, 96
    SQC2 killed %7, $a1, 112
    SQC2 killed %8, $a1, 128
    SQC2 killed %9, $a1, 144
    SQC2 killed %10, $a1, 160
    SQC2 killed %11, $a1, 176
    SQC2 killed %12, $a1, 192
    SQC2 killed %13, $a1, 208
    SQC2 killed %14, $a1, 224
    SQC2 killed %15, $a1, 240
    SQC2 killed %16, $a1, 256
    SQC2 killed %17, $a1, 272
    SQC2 killed %18, $a1, 288
    SQC2 killed %19, $a1, 304
    SQC2 killed %20, $a1, 320
    SQC2 killed %21, $a1, 336
    SQC2 killed %22, $a1, 352
    SQC2 killed %23, $a1, 368
    SQC2 killed %24, $a1, 384
    SQC2 killed %25, $a1, 400
    SQC2 killed %26, $a1, 416
    SQC2 killed %27, $a1, 432
    SQC2 killed %28, $a1, 448
    SQC2 killed %29, $a1, 464
    SQC2 killed %30, $a1, 480
    SQC2 killed %31, $a1, 496
    RetRA
...
---
name:            vu0_copy
alignment:       8
tracksRegLiveness: true
liveins:
  - { reg: '$vf2' }
body:             |
  bb.0:
    liveins: $vf2

    $vf1 = COPY killed $vf2
    RetRA implicit $vf1
...

# CHECK-LABEL: vu0_pressure:
# CHECK: sqc2 $vf{{[0-9]+}}, {{[0-9]+}}($sp)
# CHECK: lqc2 $vf{{[0-9]+}}, {{[0-9]+}}($sp)
# CHECK-NOT: st.w
# CHECK-NOT: ld.w
# CHECK-LABEL: vu0_copy:
# CHECK: vmove.xyzw $vf1, $vf2
